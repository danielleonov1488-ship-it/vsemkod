{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vsemkod-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://vsemkod.ru,https://www.vsemkod.ru",
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_NAME": "GPT‑OSS 120B",
    "AI_BACKUP_MODEL": "@cf/zai-org/glm-4.7-flash",
    "FALLBACK_BASE_URL": "https://api.groq.com/openai/v1",
    "FALLBACK_MODEL": "openai/gpt-oss-120b"
  },
  "durable_objects": {
    "bindings": [
      { "name": "IP_LIMITS", "class_name": "IpLimits" },
      { "name": "GLOBAL_QUOTA", "class_name": "GlobalQuota" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IpLimits", "GlobalQuota"] }
  ],
  "ratelimits": [
    { "name": "EDGE_LIMIT", "namespace_id": "317491", "simple": { "limit": 20, "period": 60 } }
  ]
}
