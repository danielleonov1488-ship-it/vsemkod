{
  "name": "vsemkod-catalog-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "update": "node --require=./src/tsx-windows.cjs --import tsx src/cli.ts update",
    "approve": "node --require=./src/tsx-windows.cjs --import tsx src/cli.ts approve",
    "validate": "node --require=./src/tsx-windows.cjs --import tsx src/cli.ts validate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "tsx": "4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
